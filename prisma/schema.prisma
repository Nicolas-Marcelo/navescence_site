generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  PENDING_EMAIL
  ACTIVE
  BLOCKED
}

enum NavigationHistoryStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum PoiApproachSide {
  LEFT
  RIGHT
  FRONT
}

model User {
  id              Int        @id @default(autoincrement())
  name            String     @db.VarChar(120)
  email           String     @unique @db.VarChar(180)
  passwordHash    String     @db.VarChar(255)
  role            UserRole   @default(USER)
  status          UserStatus @default(PENDING_EMAIL)
  emailVerifiedAt DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  verificationTokens EmailVerificationToken[]
  navigationHistory  NavigationHistory[]

  @@index([email])
  @@index([status])
  @@map("users")
}

model EmailVerificationToken {
  id        Int       @id @default(autoincrement())
  userId    Int
  tokenHash String    @unique @db.VarChar(64)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("email_verification_tokens")
}

model NavigationHistory {
  id                  Int                     @id @default(autoincrement())
  userId              Int
  originNodeCode      String                  @db.VarChar(30)
  destinationNodeCode String                  @db.VarChar(30)
  destinationName     String                  @db.VarChar(120)
  status              NavigationHistoryStatus @default(ACTIVE)
  startedAt           DateTime                @default(now())
  finishedAt          DateTime?
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt

  user   User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  events NavigationEvent[]

  @@index([userId])
  @@index([startedAt])
  @@index([status])
  @@map("navigation_history")
}

model NavigationEvent {
  id                  Int      @id @default(autoincrement())
  navigationHistoryId Int
  nodeCode            String   @db.VarChar(30)
  label               String?  @db.VarChar(120)
  occurredAt          DateTime @default(now())

  navigationHistory NavigationHistory @relation(fields: [navigationHistoryId], references: [id], onDelete: Cascade)

  @@index([navigationHistoryId])
  @@index([occurredAt])
  @@map("navigation_events")
}

model Node {
  id            Int      @id @default(autoincrement())
  code          String   @unique @db.VarChar(30)
  mac           String?  @unique @db.VarChar(20)
  name          String?  @db.VarChar(100)
  location      String?  @db.VarChar(150)
  x             Float?
  y             Float?
  active        Boolean  @default(true)
  maintenance   Boolean  @default(false)
  environmentId Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  environment       Environment?      @relation(fields: [environmentId], references: [id], onDelete: SetNull)
  edgesA            Edge[]            @relation("NodeA")
  edgesB            Edge[]            @relation("NodeB")
  verificationRuns  VerificationRun[]
  alerts            Alert[]
  pointsOfInterest  PointOfInterest[]
  poiApproachesFrom PoiApproach[]     @relation("PoiApproachFromNode")

  @@index([environmentId])
  @@map("nodes")
}

model Environment {
  id          Int      @id @default(autoincrement())
  code        String   @unique @db.VarChar(30)
  name        String   @db.VarChar(100)
  type        String?  @db.VarChar(40)
  floor       String   @default("Térreo") @db.VarChar(40)
  description String?  @db.VarChar(200)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  nodes Node[]

  @@map("environments")
}

model Edge {
  id        Int      @id @default(autoincrement())
  nodeAId   Int
  nodeBId   Int
  distance  Float?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  nodeA Node @relation("NodeA", fields: [nodeAId], references: [id], onDelete: Cascade)
  nodeB Node @relation("NodeB", fields: [nodeBId], references: [id], onDelete: Cascade)

  @@unique([nodeAId, nodeBId])
  @@index([nodeAId])
  @@index([nodeBId])
  @@map("edges")
}

model PointOfInterest {
  id          Int      @id @default(autoincrement())
  code        String   @unique @db.VarChar(40)
  name        String   @db.VarChar(120)
  type        String   @db.VarChar(50)
  description String?  @db.VarChar(255)
  nodeId      Int
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  node       Node          @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  approaches PoiApproach[]

  @@index([nodeId])
  @@index([type])
  @@index([active])
  @@map("points_of_interest")
}

model PoiApproach {
  id             Int             @id @default(autoincrement())
  poiId          Int
  fromNodeId     Int
  side           PoiApproachSide
  distanceMeters Float?
  instruction    String?         @db.VarChar(500)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  poi      PointOfInterest @relation(fields: [poiId], references: [id], onDelete: Cascade)
  fromNode Node            @relation("PoiApproachFromNode", fields: [fromNodeId], references: [id], onDelete: Cascade)

  @@unique([poiId, fromNodeId])
  @@index([poiId])
  @@index([fromNodeId])
  @@map("poi_approaches")
}

model VerificationRun {
  id         Int      @id @default(autoincrement())
  nodeId     Int?
  nodeCode   String   @db.VarChar(30)
  mode       String   @db.VarChar(20)
  result     String   @db.VarChar(20)
  startedAt  DateTime
  finishedAt DateTime
  durationMs Int
  createdAt  DateTime @default(now())

  node     Node?             @relation(fields: [nodeId], references: [id], onDelete: SetNull)
  readings NeighborReading[]
  alerts   Alert[]

  @@index([nodeId])
  @@index([nodeCode])
  @@index([startedAt])
  @@map("verification_runs")
}

model NeighborReading {
  id                Int      @id @default(autoincrement())
  verificationRunId Int
  neighborCode      String?  @db.VarChar(30)
  mac               String?  @db.VarChar(20)
  readings          Int?
  validReadings     Int?
  discardedReadings Int?
  averageRssi       Float?
  m15               Float?
  minRssi           Float?
  maxRssi           Float?
  advertising       String?  @db.Text
  createdAt         DateTime @default(now())

  verificationRun VerificationRun @relation(fields: [verificationRunId], references: [id], onDelete: Cascade)

  @@index([verificationRunId])
  @@index([neighborCode])
  @@map("neighbor_readings")
}

model Alert {
  id                Int       @id @default(autoincrement())
  nodeId            Int?
  nodeCode          String    @db.VarChar(30)
  verificationRunId Int?
  type              String    @db.VarChar(50)
  severity          String    @db.VarChar(20)
  status            String    @default("ACTIVE") @db.VarChar(20)
  title             String    @db.VarChar(150)
  message           String    @db.VarChar(255)
  openedAt          DateTime  @default(now())
  lastSeenAt        DateTime  @default(now())
  resolvedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  node            Node?            @relation(fields: [nodeId], references: [id], onDelete: SetNull)
  verificationRun VerificationRun? @relation(fields: [verificationRunId], references: [id], onDelete: SetNull)

  @@index([nodeId])
  @@index([nodeCode])
  @@index([verificationRunId])
  @@index([type])
  @@index([status])
  @@index([openedAt])
  @@map("alerts")
}
